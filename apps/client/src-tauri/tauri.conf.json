{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prometheus",
  "version": "0.1.0",
  "identifier": "dev.prometheus.client",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Prometheus",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:4310 ws://127.0.0.1:4310 http://localhost:4310 ws://localhost:4310; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' asset: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
