{
  "name": "@prometheus/client",
  "version": "0.1.13",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && vite build",
    "dev": "vite --host 127.0.0.1",
    "tauri": "node ./scripts/stage-sidecar.mjs --build && tauri",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.app.json --noEmit --pretty false && tsc -p tsconfig.node.json --noEmit --pretty false",
    "tauri:build": "node ./scripts/stage-sidecar.mjs --build && tauri build",
    "tauri:android:build": "tauri android build --apk --config src-tauri/tauri.mobile.conf.json",
    "tauri:ios:build": "tauri ios build --config src-tauri/tauri.mobile.conf.json",
    "stage:sidecar": "node ./scripts/stage-sidecar.mjs --build",
    "tauri:dev": "node ./scripts/stage-sidecar.mjs --build && tauri dev"
  },
  "dependencies": {
    "@fontsource-variable/source-sans-3": "5.2.6",
    "@fontsource-variable/syne": "5.2.6",
    "@fontsource/ibm-plex-mono": "5.2.6",
    "@monaco-editor/react": "^4.7.0",
    "@prometheus/protocol": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "0.542.0",
    "monaco-editor": "^0.56.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.1.5",
    "@tauri-apps/api": "2.8.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.8.4",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "jsdom": "26.1.0",
    "vite": "7.1.3",
    "vitest": "3.2.4"
  }
}
