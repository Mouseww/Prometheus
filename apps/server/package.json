{
  "name": "@prometheus/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "dev:e2e": "cross-env PROMETHEUS_DATA_FILE=:memory: PROMETHEUS_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA= tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "11.1.0",
    "@fastify/static": "8.2.0",
    "@fastify/websocket": "11.2.0",
    "@prometheus/agent-core": "workspace:*",
    "@prometheus/protocol": "workspace:*",
    "fastify": "5.5.0",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "cross-env": "10.0.0",
    "tsx": "4.20.5",
    "vitest": "3.2.4",
    "ws": "8.18.3"
  }
}
