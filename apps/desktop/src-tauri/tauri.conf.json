{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prometheus",
  "version": "0.10.2",
  "identifier": "dev.prometheus.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist",
    "beforeDevCommand": "pnpm --filter @prometheus/web dev",
    "beforeBuildCommand": "pnpm --filter @prometheus/web build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Prometheus",
        "width": 1280,
        "height": 820,
        "minWidth": 880,
        "minHeight": 560,
        "backgroundColor": "#1c1814",
        "decorations": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws: wss: http: https:; img-src 'self' data: blob: http: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src http: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYwRDk1QzU5NUU1RTBBQUIKUldTckNsNWVXVnpaWUZGb1NmeUlYSDFkdHBDWkxNVXRMZGFnMkdZVDJyZlZGdHQyTUtNVlA1SjcK",
      "endpoints": ["https://github.com/Mouseww/Prometheus/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
