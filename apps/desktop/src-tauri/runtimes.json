    {
      "id": "rust",
      "name": "Rust",
      "description": "通过 rustup 安装 stable 工具链（minimal，含 cargo）。编译还需要 C 链接器：Windows 没有 Visual Studio 生成工具时自动改用 GNU 工具链（llvm-mingw）；macOS 缺少命令行工具时会弹出系统安装窗口；Linux 需自备 cc；Android 会在基础系统里装 gcc。",
      "version": "stable",
      "probe": [
        "cargo",
        "rustc"
      ],
      "requires": [
        "rootfs"
      ],
      "env": {
        "RUSTUP_HOME": "{dir}/rustup",
        "CARGO_HOME": "{dir}/cargo"
      },
      "targets": {
        "windows-x86_64": {
          "urls": [
            "https://static.rust-lang.org/rustup/dist/x86_64-pc-windows-msvc/rustup-init.exe",
            "https://rsproxy.cn/rustup/dist/x86_64-pc-windows-msvc/rustup-init.exe"
          ],
          "sha256Url": "https://static.rust-lang.org/rustup/dist/x86_64-pc-windows-msvc/rustup-init.exe.sha256",
          "sizeMb": 300,
          "format": "exe",
          "bin": [
            "cargo/bin"
          ],
          "check": "cargo/bin/cargo.exe",
          "run": [
            "-y",
            "--no-modify-path",
            "--profile",
            "minimal",
            "--default-toolchain",
            "stable"
          ],
          "needsLinker": true,
          "gnuFallback": {
            "requires": "llvm-mingw",
            "host": "x86_64-pc-windows-gnu",
            "linker": "bin/x86_64-w64-mingw32-clang.exe",
            "config": "cargo/config.toml"
          }
        },
        "windows-aarch64": {
          "urls": [
            "https://static.rust-lang.org/rustup/dist/aarch64-pc-windows-msvc/rustup-init.exe",
            "https://rsproxy.cn/rustup/dist/aarch64-pc-windows-msvc/rustup-init.exe"
          ],
          "sha256Url": "https://static.rust-lang.org/rustup/dist/aarch64-pc-windows-msvc/rustup-init.exe.sha256",
          "sizeMb": 300,
          "format": "exe",
          "bin": [
            "cargo/bin"
          ],
          "check": "cargo/bin/cargo.exe",
          "run": [
            "-y",
            "--no-modify-path",
            "--profile",
            "minimal",
            "--default-toolchain",
            "stable"
          ],
          "needsLinker": true
        },
        "linux-x86_64": {
          "urls": [
            "https://static.rust-lang.org/rustup/dist/x86_64-unknown-linux-gnu/rustup-init",
            "https://rsproxy.cn/rustup/dist/x86_64-unknown-linux-gnu/rustup-init"
          ],
          "sha256": "5be191e8c70a5007074254cb74d78dbfdd25cd5a61c27de7b8e5410122ec24f4",
          "sizeMb": 300,
          "format": "exe",
          "bin": [
            "cargo/bin"
          ],
          "check": "cargo/bin/cargo",
          "run": [
            "-y",
            "--no-modify-path",
            "--profile",
            "minimal",
            "--default-toolchain",
            "stable"
          ],
          "needsLinker": true
        },
        "linux-aarch64": {
          "urls": [
            "https://static.rust-lang.org/rustup/dist/aarch64-unknown-linux-gnu/rustup-init",
